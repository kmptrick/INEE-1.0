    {
      "parameters": {
        "functionCode": "// Toutes les boites email arrivent ici. On lit $json (= l email qui a declenche).\nfunction stripHtml(html){\n  if(!html) return '';\n  return html.replace(/<style[\\s\\S]*?<\\/style>/gi,'').replace(/<script[\\s\\S]*?<\\/script>/gi,'').replace(/<[^>]+>/g,' ').replace(/&nbsp;/g,' ').replace(/&amp;/g,'&').replace(/&lt;/g,'<').replace(/&gt;/g,'>').replace(/&quot;/g,'\"').replace(/\\s{2,}/g,' ').trim();\n}\nconst t = $json;\nconst rawBody = t.body && t.body.contentType === 'html' ? stripHtml(t.body.content||'') : (t.body && t.body.content ? t.body.content : (t.bodyPreview||''));\nconst body = rawBody.length > 3000 ? rawBody.substring(0,3000)+'... [tronque]' : rawBody;\nconst senderEmail = (t.from && t.from.emailAddress && t.from.emailAddress.address) || '';\nconst senderName = (t.from && t.from.emailAddress && t.from.emailAddress.name) || senderEmail || 'Inconnu';\nconst subject = t.subject || '(sans objet)';\nconst messageId = t.id || '';\nconst mailbox = (t.toRecipients && t.toRecipients[0] && t.toRecipients[0].emailAddress && t.toRecipients[0].emailAddress.address) || '';\nconst chatInput = `Expediteur: ${senderName} <${senderEmail}>\\nObjet: ${subject}\\n\\n${body || 'Email vide.'}`;\nreturn [{ json: { chatInput, senderEmail, senderName, subject, messageId, mailbox } }];"
      },
      "id": "prep-email",
      "name": "Prepare Email",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [360, 1040]
