    {
      "parameters": {
        "functionCode": "// Parse le JSON renvoye par l agent pour la branche EMAIL\nlet raw = ($input.item.json.output) || '';\nraw = raw.replace(/```json/g,'').replace(/```/g,'').trim();\nlet p;\ntry { p = JSON.parse(raw); } catch(e){ p = { classification:'FROID', resume:'Erreur de parsing', actions:'Verifier manuellement', brouillon: raw }; }\nreturn [{ json: p }];"
      },
      "id": "parse-email",
      "name": "Parse Email JSON",
      "type": "n8n-nodes-base.function",
      "typeVersion": 1,
      "position": [1560, 700]
